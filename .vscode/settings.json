{
  // Type-check in the editor with the same TypeScript the build uses (5.6.3).
  // Without the prompt, VS Code silently falls back to its own bundled version,
  // which currently ships TS 7 previews and reports removals 5.6 still accepts.
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "prisma.pinToPrisma6": true,

  // Live squiggles from eslint.config.mjs (flat config) while typing
  "eslint.useFlatConfig": true,
  "eslint.run": "onType",
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact"
  ],

  // Apply the auto-fixable rules on every save — formatting, import order,
  // jsx-sort-props, padding-line-between-statements. These are what pile up.
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // Prettier runs *through* eslint-plugin-prettier here. Do not also enable the
  // Prettier extension as a formatter — the two passes fight over the same lines.
  "editor.formatOnSave": false
}
