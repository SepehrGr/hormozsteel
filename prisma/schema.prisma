// Hormoz Steel demo — clean catalog schema for portfolio use.
// Domain: categories → products (+ manufacturer) → price history
//          auth (NextAuth) · light CRM (contact / quick order)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  SUPER_ADMIN
}

enum ProductUnit {
  KG
  TON
  PIECE
  METER
}

/// Latest price movement on a product (also used in price history rows).
enum PriceDirection {
  UP
  DOWN
  STABLE
}

enum ContactFormStatus {
  NEW
  READ
  REPLIED
}

enum QuickOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  PICKUP
  DELIVERY
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  /// Icomoon CSS class name, e.g. "icon-rebar" (see styles/icomoon.css). Not emoji.
  icon        String?
  sortOrder   Int       @default(0)
  /// Free-form subcategory labels used in UI (English).
  subcategories String[]

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

model Manufacturer {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  logo        String?
  website     String?
  email       String?
  phone       String?
  address     String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("manufacturers")
}

model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  /// Display size label, e.g. "16mm", "IPE 200".
  size String
  unit ProductUnit @default(KG)

  price         Decimal  @db.Decimal(12, 2)
  priceDirection PriceDirection @default(STABLE)
  priceDelta    Decimal? @db.Decimal(12, 2)
  priceUpdatedAt DateTime?

  weightKg Float?
  inStock  Boolean  @default(true)
  images   String[]

  /// Label within the parent category, e.g. "Ribbed", "Hot-rolled".
  subcategory String?

  /// Type-specific attributes: diameter, grade, coating, standard, etc.
  specs        Json?
  features     String[]
  applications String[]

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)

  priceHistory PriceHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, subcategory])
  @@index([manufacturerId])
  @@index([inStock])
  @@index([price])
  @@map("products")
}

model PriceHistory {
  id        String         @id @default(cuid())
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  oldPrice  Decimal        @db.Decimal(12, 2)
  newPrice  Decimal        @db.Decimal(12, 2)
  direction PriceDirection
  delta     Decimal        @db.Decimal(12, 2)
  note      String?
  changedAt DateTime       @default(now())

  @@index([changedAt])
  @@index([productId, changedAt(sort: Desc)])
  @@map("price_history")
}

// ─── Auth (NextAuth) ─────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String
  role          Role      @default(ADMIN)
  isActive      Boolean   @default(true)
  lastLogin     DateTime?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  adminLogs AdminLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model AdminLog {
  id           String  @id @default(cuid())
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String
  userEmail    String
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("admin_logs")
}

// ─── Inbound leads ───────────────────────────────────────────────────────────

model ContactForm {
  id        String            @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  status    ContactFormStatus @default(NEW)
  repliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_forms")
}

model QuickOrder {
  id              String           @id @default(cuid())
  customerName    String
  companyName     String?
  phoneNumber     String
  city            String
  productSpecs    String
  quantity        String
  deliveryDate    DateTime?        @db.Date
  deliveryMethod  DeliveryMethod   @default(PICKUP)
  additionalNotes String?
  status          QuickOrderStatus @default(PENDING)
  productName     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("quick_orders")
}
